{
  "family": "flowforge",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/flowforgeTaskRole",
  "containerDefinitions": [
    {
      "name": "flowforge",
      "image": "ACCOUNT_ID.dkr.ecr.eu-west-2.amazonaws.com/flowforge:latest",
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "essential": true,
      "environment": [
        { "name": "PORT", "value": "8080" },
        { "name": "REDIS_ENABLED", "value": "true" },
        { "name": "REDIS_HOST", "value": "flowforge.xxxxx.0001.euw2.cache.amazonaws.com" },
        { "name": "LLM_PROVIDER", "value": "heuristic" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/flowforge",
          "awslogs-region": "eu-west-2",
          "awslogs-stream-prefix": "api"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:8080/actuator/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3
      }
    }
  ]
}
